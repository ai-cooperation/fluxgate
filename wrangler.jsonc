{
  "name": "fluxgate",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // Workers AI binding (LLM routing + FLUX image generation).
  "ai": { "binding": "AI" },
  // R2 image storage. Generated images are served by the Worker at /i/<key>.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "fluxgate-images" }
  ],
  // KV stores API keys, job state, anonymous cooldowns and daily usage counts.
  // Replace this id after running: npx wrangler kv namespace create KV
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // Daily cleanup. Normal generated image keys use YYYY-MM-DD/... and expire.
  // Homepage example images under examples/... are not date-prefixed and are retained.
  "triggers": { "crons": ["0 17 * * *"] },
  "vars": { "RETENTION_DAYS": "7" },
  "observability": { "enabled": true }
}
